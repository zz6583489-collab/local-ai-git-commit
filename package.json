{
  "name": "ai-git-commit",
  "displayName": "AI Git Commit",
  "description": "用云端 AI 为 Git 变更生成中文 Conventional Commit 信息",
  "version": "0.1.5",
  "publisher": "local-ai-git-commit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zz6583489-collab/local-ai-git-commit.git"
  },
  "bugs": {
    "url": "https://github.com/zz6583489-collab/local-ai-git-commit/issues"
  },
  "homepage": "https://github.com/zz6583489-collab/local-ai-git-commit#readme",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "npm run compile && node --test out/test/unit/*.test.js",
    "test:integration": "npm run compile && node out/test/runTest.js",
    "test": "npm run test:unit && npm run test:integration",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "contributes": {
    "commands": [
      {
        "command": "aiGitCommit.generate",
        "title": "AI Git Commit: Generate Commit Message",
        "icon": "$(sparkle)"
      },
      {
        "command": "aiGitCommit.regenerate",
        "title": "AI Git Commit: Regenerate Commit Message"
      },
      {
        "command": "aiGitCommit.copy",
        "title": "AI Git Commit: Copy Commit Message"
      },
      {
        "command": "aiGitCommit.cancel",
        "title": "AI Git Commit: Cancel Generation"
      },
      {
        "command": "aiGitCommit.setApiKey",
        "title": "AI Git Commit: Set API Key"
      },
      {
        "command": "aiGitCommit.deleteApiKey",
        "title": "AI Git Commit: Delete API Key"
      },
      {
        "command": "aiGitCommit.checkApiKey",
        "title": "AI Git Commit: Check API Key"
      },
      {
        "command": "aiGitCommit.selectProvider",
        "title": "AI Git Commit: Select Provider"
      },
      {
        "command": "aiGitCommit.configureModel",
        "title": "AI Git Commit: Configure Model"
      },
      {
        "command": "aiGitCommit.testConnection",
        "title": "AI Git Commit: Test API Connection"
      },
      {
        "command": "aiGitCommit.showLogs",
        "title": "AI Git Commit: Show Logs"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "aiGitCommit.generate",
          "when": "scmProvider == git",
          "group": "navigation@50"
        }
      ],
      "scm/sourceControl": [
        {
          "command": "aiGitCommit.generate",
          "when": "scmProvider == git",
          "group": "1_ai"
        }
      ],
      "scm/repository": [
        {
          "command": "aiGitCommit.generate",
          "when": "scmProvider == git",
          "group": "1_ai"
        }
      ]
    },
    "configuration": {
      "title": "AI Git Commit",
      "properties": {
        "aiGitCommit.provider": {
          "type": "string",
          "scope": "application",
          "enum": [
            "openai",
            "deepseek",
            "qwen",
            "siliconflow",
            "custom"
          ],
          "default": "custom",
          "description": "仅在用户设置中配置服务商；工作区不能改写 API Key 的发送目标。API Key 单独保存在 SecretStorage。"
        },
        "aiGitCommit.baseUrl": {
          "type": "string",
          "scope": "application",
          "default": "",
          "description": "仅在用户设置中配置自定义服务商的 HTTPS API 根地址，例如 https://example.com/v1。所选 Git 差异会发送到此地址。"
        },
        "aiGitCommit.model": {
          "type": "string",
          "default": "",
          "description": "模型 ID。留空时使用服务商预设模型。"
        },
        "aiGitCommit.language": {
          "type": "string",
          "default": "zh-CN",
          "description": "提交信息语言，默认简体中文。"
        },
        "aiGitCommit.timeout": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 300000,
          "default": 120000,
          "description": "每次 API 请求超时，单位毫秒。"
        },
        "aiGitCommit.temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 0.2,
          "description": "模型温度；兼容端点不支持时可关闭发送。"
        },
        "aiGitCommit.sendTemperature": {
          "type": "boolean",
          "default": false,
          "description": "是否发送 temperature 参数。默认关闭以兼容更多模型。"
        },
        "aiGitCommit.maxDiffLength": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 200000,
          "default": 30000,
          "description": "单次摘要请求的最大字符预算。"
        },
        "aiGitCommit.maxContextTokens": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 100000,
          "default": 16000,
          "description": "单次请求的近似 Token 预算；实际用量以服务商为准。"
        },
        "aiGitCommit.maxSummaryCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "default": 10,
          "description": "大型差异的局部摘要与必要压缩的请求次数上限；初始分组超过上限时可选择仅本次继续。"
        },
        "aiGitCommit.autoFill": {
          "type": "boolean",
          "default": true,
          "description": "生成后填写当前仓库的 SCM 提交输入框。"
        },
        "aiGitCommit.confirmOverwrite": {
          "type": "boolean",
          "default": true,
          "description": "覆盖已有提交信息前确认。"
        },
        "aiGitCommit.conventionalCommits": {
          "type": "boolean",
          "default": true,
          "description": "要求 Conventional Commits 格式；提示词模式下校验第一行必须包含 type 和 scope。"
        },
        "aiGitCommit.outputFormat": {
          "type": "string",
          "enum": [
            "singleLine",
            "prompt"
          ],
          "default": "singleLine",
          "description": "singleLine 保持单行提交信息；prompt 允许由自定义提示词或文件定义多行格式。"
        },
        "aiGitCommit.promptFile": {
          "type": "string",
          "default": "",
          "description": "可选的提示词规则文件；相对路径按所选 Git 仓库根目录解析。绝对路径仅可在用户设置中配置。文件内容会发送给模型。"
        },
        "aiGitCommit.customPrompt": {
          "type": "string",
          "default": "",
          "description": "附加格式或生成规则；提示词模式可用它定义完整输出格式。暂存 Diff 始终被视为数据，不作为指令。"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
